{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "generate:api": "openapi-typescript ../contract/openapi.yaml -o src/lib/api-types.ts",
    "test": "tsc --noEmit && vitest run && playwright test",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run -s generate:api",
    "prebuild": "npm run -s generate:api",
    "predev": "npm run -s generate:api",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "^31.0.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
